{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-native",
    "outDir": "lib",
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["lib", "node_modules"]
}
